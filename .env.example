# ---------------------------------------------------------------
# Call Jack Pro — configuration. Copy to .env.local (dev) or set in
# your host's environment settings (e.g. Vercel → Settings → Env).
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing.
# ---------------------------------------------------------------

# REQUIRED before launch
NEXT_PUBLIC_SITE_URL=https://www.example.com          # canonical origin, no trailing slash
NEXT_PUBLIC_PHONE_DISPLAY=(555) 123-4567              # shown on every call button
NEXT_PUBLIC_PHONE_E164=+15551234567                   # used in tel: links (derived from display if omitted)

# Recommended
NEXT_PUBLIC_SERVICE_AREAS=                            # comma-separated cities/areas actually served
NEXT_PUBLIC_REGION_LABEL=                             # e.g. "Springfield, IL" (used in footer copy)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HANDYMAN_HOURS=Scheduled by appointment
NEXT_PUBLIC_LOCKOUT_24_7=true                         # set to false if 24/7 lockout coverage stops

# Only if you have a public storefront. Leave blank for a service-area business.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_COUNTRY=US
NEXT_PUBLIC_LEGAL_NAME=

# ---- Service request form delivery (server-only; configure at least one) ----
# Option A: webhook (Zapier, Make, n8n, Slack workflow, CRM…) — receives JSON POST
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=                                  # optional, sent as "Authorization: Bearer <secret>"
# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=                                        # comma-separated recipients
LEAD_EMAIL_FROM=                                      # verified sender, e.g. "Call Jack Pro <leads@yourdomain.com>"
